@import url(https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Oxanium:wght@200..800&display=swap);
.main-navbar {
  background: #FFF;
  box-shadow: 0px 4px 13.9px 0px rgba(0, 0, 0, 0.07);
  height: 56px;
  display: flex;
  align-items: center;
  position: fixed;
  z-index: 9;
  width: 100%;
}
.main-navbar .content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.main-navbar .content .menus {
  padding: 0;
  display: flex !important;
  flex-direction: row;
  align-items: center;
  gap: 40px;
  margin: 0;
}
.main-navbar .content .menus .item {
  list-style: none;
}
.main-navbar .content .menus .item a {
  text-decoration: none;
  color: #131315;
  font-size: 17px;
}
@media (max-width: 992px) {
  .main-navbar .content .menus {
    position: fixed;
    height: 100vh;
    width: 90%;
    align-items: start;
    padding: 30px;
    top: 0;
    left: -100%;
    flex-direction: column;
    background: white;
    box-shadow: rgba(100, 100, 111, 0.7) 0px 33px 53px 0px;
    transition: all 0.3s;
  }
  .main-navbar .content .menus.opened {
    left: 0;
    transition: all 0.3s;
  }
}
.main-navbar .content .btn-login img {
  filter: brightness(100);
}

.main-footer {
  background: #151A40;
  padding: 20px;
}
.main-footer .container {
  display: flex;
  justify-content: space-between;
}
@media (max-width: 992px) {
  .main-footer .container {
    flex-direction: column;
  }
}
.main-footer .container .left {
  max-width: 369px;
}
@media (max-width: 992px) {
  .main-footer .container .left {
    margin-bottom: 40px;
  }
}
.main-footer .container .right {
  display: flex;
  gap: 100px;
}
@media (max-width: 768px) {
  .main-footer .container .right {
    flex-direction: column;
    gap: 30px;
  }
}
.main-footer .container .right .links {
  display: flex;
  flex-direction: column;
  gap: 15px;
}
.main-footer .container .right .links .text {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

